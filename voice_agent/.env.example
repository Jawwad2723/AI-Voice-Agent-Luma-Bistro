# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Reservation API (local mock) ---
RESERVATION_API_BASE_URL=http://localhost:8000

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Token endpoint for the browser client (optional local token server)
LIVEKIT_TOKEN_TTL_SECONDS=3600

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- DeepSeek (LLM) ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- ElevenLabs (TTS) ---
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVEN_MODEL_ID=eleven_turbo_v2_5

# --- Twilio (phone ingress) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# LiveKit SIP / Telephony (fill when wiring phone)
# LIVEKIT_SIP_TRUNK_ID=
# LIVEKIT_SIP_DISPATCH_RULE_ID=

# --- Agent behavior ---
LOG_LEVEL=INFO
LOG_DIR=logs
SILENCE_TIMEOUT_SECONDS=8
AVAILABILITY_MAX_RETRIES=1
